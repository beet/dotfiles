# Colour scheme
# theme = Ayu Mirage
theme = Gruvbox Dark
# theme = Tokyo Night Moon

# Font
# font-family = Menlo
font-family = JetBrains Mono
# font-family = Andale Mono
font-size = 15

# Window: hide the title bar but keep resizable edges
macos-titlebar-style = hidden

# CMD+K resets the terminal
# keybind = cmd+k=reset

# Not in your WezTerm config, but recommended with Zellij:
# make Option send Alt so Zellij's Alt keybindings work
macos-option-as-alt = true


# Remove all of Ghostty's default keybindings
keybind = clear

# Window
keybind = cmd+n=new_window
keybind = cmd+w=close_surface
keybind = cmd+q=quit

# Clipboard (Zellij can't paste from the macOS clipboard itself)
keybind = cmd+c=copy_to_clipboard
keybind = cmd+v=paste_from_clipboard

# Config
# keybind = cmd+comma=open_config
keybind = cmd+shift+comma=reload_config
