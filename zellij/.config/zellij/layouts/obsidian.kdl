layout {
  cwd "/Users/markbeattie/Documents/Obsidian Vaults/Labflow"

  //
  // Applied to every tab: tab-bar across the top, status-bar across the
  // bottom. `children` is where each tab's own panes get slotted in.
  default_tab_template {
    pane size=1 borderless=true {
      plugin location="zellij:tab-bar"
    }
    children
    pane size=1 borderless=true {
      plugin location="zellij:status-bar"
    }
  }

  tab name="nvim" hide_floating_panes=true {
    pane command="nvim"
  }

  tab name="gitui" hide_floating_panes=true {
    pane command="gitui"
  }
}
