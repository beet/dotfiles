layout {
  cwd "/Users/markbeattie/dotfiles"

  // Applied to every tab: tab-bar across the top, status-bar across the
  // bottom. `children` is where each tab's own panes get slotted in.
  default_tab_template {
    pane size=1 borderless=true {
      plugin location="zellij:tab-bar"
    }
    children
    pane size=1 borderless=true {
      plugin location="zellij:status-bar"
    }
  }

  tab name="nvim" focus=true {
    pane command="nvim" focus=true {
      args "README.md"
    }
  }

  tab name="gitui" {
    pane command="gitui"
  }

  tab name="Hunk" {
    pane command="hunk" {
      args "diff" "--watch"
    }
  }
}
