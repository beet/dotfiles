#!/usr/bin/env bash
# wt-cleanup — remove a merged feature worktree, branch, and Zellij session.
# * Run from inside the worktree to be cleaned up.
# * Options: --branch <name> (default: develop), --force (skip safety guards).
# * Drops the worktree's own DEV_DATABASE_NAME database, if it has one.
# * Will exit Zellij on completion
set -euo pipefail

target_branch=develop
force=0
while [[ $# -gt 0 ]]; do
  case $1 in
  --branch)
    target_branch=$2
    shift 2
    ;;
  --branch=*)
    target_branch=${1#*=}
    shift
    ;;
  --force)
    force=1
    shift
    ;;
  *)
    echo "unknown arg: $1" >&2
    exit 1
    ;;
  esac
done

# Resolved before anything cds: the detached child below re-runs this script.
self=$0
[[ $self == /* ]] || self=$PWD/$self

# Kill the session, then tear the worktree down. Order matters: panes still
# alive in the session write into the worktree, and a Rails server rebuilds
# tmp/cache/bootsnap the moment git deletes it -- which is why cleanups used to
# leave a directory containing nothing but tmp/ behind.
finish() {
  if [[ -n $session ]]; then
    zellij delete-session --force "$session" || true
    # delete-session returns before the panes' processes have all reaped.
    for _ in {1..20}; do
      zellij list-sessions -n 2>/dev/null | grep -q "^$session " || break
      sleep 0.25
    done
  fi

  cd "$main_repo"
  local flags=()
  ((force)) && flags=(--force)
  git worktree remove "${flags[@]}" "$worktree_path"
  # A pane that outlived the kill can still have recreated an ignored path;
  # git leaves the directory in place when it does.
  [[ -d $worktree_path ]] && rm -rf "$worktree_path"
  git worktree prune
  git branch -D "$branch"
  [[ -n $database ]] && dropdb --if-exists "$database"
  return 0
}

# Phase two, re-entered as a detached child so it outlives the session it
# kills. Everything it needs arrives through the environment -- by then the
# worktree it was launched from is on its way out.
if [[ -n ${WT_CLEANUP_FINISH:-} ]]; then
  worktree_path=$WT_CLEANUP_WORKTREE
  branch=$WT_CLEANUP_BRANCH
  main_repo=$WT_CLEANUP_MAIN
  session=$WT_CLEANUP_SESSION
  database=$WT_CLEANUP_DATABASE
  force=$WT_CLEANUP_FORCE
  finish
  exit 0
fi

git rev-parse --is-inside-work-tree >/dev/null

# Resolve the current Zellij session name.
#
# ZELLIJ_SESSION_NAME is snapshotted into a pane's environment when the pane is
# created, so it goes stale once the session is renamed -- and `zellij
# list-sessions` derives its "(current)" marker from that same stale value, so
# it is no help either. Instead, find the `zellij --server <socket>` ancestor of
# this script and match it to its socket file: a rename moves the file but
# preserves the mtime, which equals the server's start time.
current_session() {
  local pid=$$ ppid cmd socket= started f
  local -a matches=()

  while [[ -n $pid && $pid -gt 1 ]]; do
    ppid= cmd=
    read -r ppid cmd < <(ps -o ppid=,command= -p "$pid" 2>/dev/null) || true
    # A vanished process leaves ppid empty; bail rather than re-walk the same pid.
    [[ -n $ppid ]] || return 0
    if [[ $cmd == *"zellij --server "* ]]; then
      socket=${cmd#*--server }
      break
    fi
    pid=$ppid
  done
  [[ -n $socket ]] || return 0

  started=$(LC_ALL=C date -j -f "%a %b %e %H:%M:%S %Y" \
    "$(LC_ALL=C ps -o lstart= -p "$pid")" +%s 2>/dev/null) || return 0

  for f in "$(dirname "$socket")"/*; do
    if [[ -S $f && $(stat -f %m "$f" 2>/dev/null) == "$started" ]]; then
      matches+=("$f")
    fi
  done

  # Only trust an unambiguous match -- deleting the wrong session is unrecoverable.
  if ((${#matches[@]} == 1)); then
    basename "${matches[0]}"
  fi
  return 0
}

# The per-worktree database wt-setup created, if any. Read it before the
# worktree is removed -- .env.local goes with it.
worktree_database() {
  local env_file=$1/.env.local name
  [[ -f $env_file ]] || return 0
  name=$(grep '^DEV_DATABASE_NAME=' "$env_file" | tail -1 | cut -d= -f2-)
  name=${name%\"}
  name=${name#\"}
  # Never offer to drop the shared development database.
  [[ -z $name || $name == labmaster_development ]] && return 0
  psql -tAc "SELECT 1 FROM pg_database WHERE datname = '$name'" postgres 2>/dev/null |
    grep -q 1 || return 0
  printf '%s' "$name"
}

worktree_path=$(git rev-parse --show-toplevel)
branch=$(git branch --show-current)
session=$(current_session)
main_repo=$(git worktree list --porcelain | awk '/^worktree /{print $2; exit}')
database=$(worktree_database "$worktree_path")

if [[ "$worktree_path" == "$main_repo" ]]; then
  echo "Refusing to clean the main worktree ($worktree_path)" >&2
  exit 1
fi

if [[ -n "$(git status --porcelain)" ]]; then
  if ((force)); then
    echo "Warning: working tree has uncommitted changes:"
    git status --short
    echo ""
  else
    echo "Working tree has uncommitted changes" >&2
    exit 1
  fi
fi

git fetch origin "$target_branch" --quiet
if ! git merge-base --is-ancestor HEAD "origin/$target_branch"; then
  if ((force)); then
    ahead=$(git rev-list --count "origin/$target_branch..HEAD")
    echo "Warning: $branch is not merged into origin/$target_branch ($ahead commit(s) ahead)"
    echo ""
  else
    echo "$branch is not merged into origin/$target_branch" >&2
    exit 1
  fi
fi

echo ""
echo "Worktree: $worktree_path"
echo "Branch:   $branch"
[[ -n "$session" ]] && echo "Session:  $session"
[[ -n "$database" ]] && echo "Database: $database (will be dropped)"
echo ""

read -rp "Proceed? [y/N] " ok
[[ "$ok" =~ ^[Yy]$ ]] || exit 0

if [[ -z "$session" ]]; then
  # Nothing is going to write the worktree back into place; stay in the
  # foreground so the output lands on screen.
  finish
  exit 0
fi

log="${TMPDIR:-/tmp}/wt-cleanup-$(basename "$worktree_path").log"
echo "Closing $session; cleanup continues in the background."
echo "Log: $log"

WT_CLEANUP_FINISH=1 \
  WT_CLEANUP_WORKTREE="$worktree_path" \
  WT_CLEANUP_BRANCH="$branch" \
  WT_CLEANUP_MAIN="$main_repo" \
  WT_CLEANUP_SESSION="$session" \
  WT_CLEANUP_DATABASE="$database" \
  WT_CLEANUP_FORCE="$force" \
  nohup "$self" >"$log" 2>&1 &
disown
