#!/usr/bin/env bash
# wt-setup — prepare a freshly branched Rails worktree for development.
# * Run from inside the new worktree.
# * Seeds .env.local from the main worktree, pins DEV_DATABASE_NAME to a
#   per-ticket database and PORT to a free port, builds assets, and bootstraps
#   the database.
# * Options: --ticket <key>, --db <name>, --port <n>, --skip-assets, --skip-db,
#   --force.
set -euo pipefail

ticket=
db_name=
port=
skip_assets=0
skip_db=0
force=0
while [[ $# -gt 0 ]]; do
  case $1 in
  --ticket)
    ticket=$2
    shift 2
    ;;
  --ticket=*)
    ticket=${1#*=}
    shift
    ;;
  --db)
    db_name=$2
    shift 2
    ;;
  --db=*)
    db_name=${1#*=}
    shift
    ;;
  --port)
    port=$2
    shift 2
    ;;
  --port=*)
    port=${1#*=}
    shift
    ;;
  --skip-assets)
    skip_assets=1
    shift
    ;;
  --skip-db)
    skip_db=1
    shift
    ;;
  --force)
    force=1
    shift
    ;;
  *)
    echo "unknown arg: $1" >&2
    exit 1
    ;;
  esac
done

git rev-parse --is-inside-work-tree >/dev/null

worktree_path=$(git rev-parse --show-toplevel)
branch=$(git branch --show-current)
main_repo=$(git worktree list --porcelain | awk '/^worktree /{print $2; exit}')

if [[ "$worktree_path" == "$main_repo" ]]; then
  echo "Refusing to set up the main worktree ($worktree_path)" >&2
  exit 1
fi

cd "$worktree_path"

# Ticket key: a LETTERS-DIGITS token at the start of a branch path segment --
# anchoring keeps prose like "averaged-36525-day" out of the running. Branches
# carry several prefixes (lab/, chore/LMCP-, feature/lmap-...), so keep the
# project prefix in the database name; bare numbers collide across projects.
infer_ticket() {
  local -a found=()
  local key
  while read -r key; do
    key=$(tr '[:upper:]' '[:lower:]' <<<"${key#/}")
    [[ " ${found[*]:-} " == *" $key "* ]] || found+=("$key")
  done < <(grep -oE '(^|/)[A-Za-z]{2,10}-[0-9]+' <<<"$branch" || true)

  # Only trust an unambiguous match -- the wrong key silently points the app at
  # someone else's database.
  ((${#found[@]} == 1)) && printf '%s' "${found[0]}"
  return 0
}

if [[ -z "$ticket" ]]; then
  ticket=$(infer_ticket)
fi

if [[ -z "$ticket" && -z "$db_name" ]]; then
  echo "Cannot infer a ticket from branch: $branch"
  read -rp "Ticket key (e.g. LAB-408), or blank to skip: " ticket
  ticket=$(tr '[:upper:]' '[:lower:]' <<<"$ticket")
fi

if [[ -z "$db_name" ]]; then
  if [[ -n "$ticket" ]]; then
    db_name="labmaster_development_${ticket//-/_}"
  else
    echo "No ticket and no --db: nothing to point DEV_DATABASE_NAME at" >&2
    exit 1
  fi
fi

# Port: .envrc runs `dotenv_if_exists .env.local`, so PORT set there reaches
# config/puma.rb (ENV.fetch("PORT", 3000)) and Procfile.dev alike -- both
# `bin/rails s` and `bin/dev` land on it without a flag.
#
# Seed from a hash of the database name so a worktree keeps the same port
# across re-runs (bookmarks and OAuth callbacks stay valid), then walk forward
# until a port is neither listening nor already claimed by another worktree.
port_in_use() {
  (exec 3<>"/dev/tcp/127.0.0.1/$1") 2>/dev/null
}

# Ports other worktrees have taken. A worktree whose server is stopped still
# owns its port -- an unclaimed-looking port handed out twice collides the next
# time both are running.
claimed_ports() {
  local wt env_file
  while read -r wt; do
    [[ $wt == "$worktree_path" ]] && continue
    env_file="$wt/.env.local"
    [[ -f $env_file ]] || continue
    (grep '^PORT=' "$env_file" || true) | tail -1 | cut -d= -f2- | tr -d '"'
  done < <(git worktree list --porcelain | awk '/^worktree /{print $2}')
}

# 3000 is left to the main worktree; 3001-3099 is the worktree pool.
pick_port() {
  local base candidate i claimed
  claimed=" $(claimed_ports | tr '\n' ' ') "
  base=$(cksum <<<"$db_name" | cut -d' ' -f1)
  for ((i = 0; i < 99; i++)); do
    candidate=$((3001 + (base + i) % 99))
    [[ $claimed == *" $candidate "* ]] && continue
    port_in_use "$candidate" && continue
    printf '%s' "$candidate"
    return 0
  done
  echo "No free port in 3001-3099" >&2
  return 1
}

# .env.local is gitignored, so a new worktree starts without the GitHub
# Packages token that `yarn` needs. Carry the main worktree's copy over.
env_file="$worktree_path/.env.local"
if [[ ! -f "$env_file" ]]; then
  if [[ -f "$main_repo/.env.local" ]]; then
    cp "$main_repo/.env.local" "$env_file"
    echo "Seeded .env.local from $main_repo"
  else
    echo "Warning: no .env.local in $main_repo -- yarn may fail to authenticate"
    : >"$env_file"
  fi
fi

# An unterminated last line would swallow the variable we append below.
[[ -s "$env_file" && -n $(tail -c 1 "$env_file") ]] && printf '\n' >>"$env_file"

upsert_env() {
  local key=$1 value=$2 existing
  if grep -q "^$key=" "$env_file"; then
    existing=$(grep "^$key=" "$env_file" | tail -1 | cut -d= -f2-)
    [[ "$existing" == "$value" ]] && return 0
    grep -v "^$key=" "$env_file" >"$env_file.tmp"
    mv "$env_file.tmp" "$env_file"
    printf '%s=%s\n' "$key" "$value" >>"$env_file"
    echo "$key: $existing -> $value"
    return 0
  fi
  printf '%s=%s\n' "$key" "$value" >>"$env_file"
}

upsert_env DEV_DATABASE_NAME "$db_name"

# An already-assigned port is this worktree's own; re-running setup should not
# move a server that tabs and callbacks are already pointed at.
if [[ -z "$port" ]]; then
  port=$( (grep '^PORT=' "$env_file" || true) | tail -1 | cut -d= -f2- | tr -d '"')
fi
[[ -z "$port" ]] && port=$(pick_port)
upsert_env PORT "$port"

export DEV_DATABASE_NAME="$db_name"
export PORT="$port"
# yarn reads npmAuthToken from the environment via .yarnrc.yml, and direnv has
# not necessarily allowed this worktree's .envrc yet.
set -a
# shellcheck disable=SC1090
source "$env_file"
set +a

if command -v direnv >/dev/null 2>&1 && [[ -f "$worktree_path/.envrc" ]]; then
  direnv allow "$worktree_path"
fi

echo ""
echo "Worktree: $worktree_path"
echo "Branch:   $branch"
echo "Database: $db_name"
echo "Port:     $port (http://localhost:$port)"
echo ""

if ((!skip_assets)); then
  echo "== Assets =="
  yarn
  yarn build
  yarn build:css
fi

db_exists() {
  psql -tAc "SELECT 1 FROM pg_database WHERE datname = '$1'" postgres 2>/dev/null | grep -q 1
}

if ((!skip_db)); then
  echo ""
  echo "== Database =="
  if db_exists "$db_name" && ((!force)); then
    read -rp "$db_name already exists; reload it? [y/N] " ok
    if [[ ! "$ok" =~ ^[Yy]$ ]]; then
      echo "Leaving $db_name as it is."
      exit 0
    fi
  fi
  bin/rails db:setup
fi
