#!/usr/bin/env bash
# wt-setup — prepare a freshly branched Rails worktree for development.
# * Run from inside the new worktree.
# * Seeds .env.local from the main worktree, pins DEV_DATABASE_NAME and
#   TEST_DATABASE_NAME to per-ticket databases and PORT to a free port, builds
#   assets, and bootstraps both databases.
# * TEST_DATABASE_NAME also goes to .env.test.local, the only one of the two
#   dotenv-rails reads under RAILS_ENV=test.
# * Regenerates .rspec-local via `agentmon init-rspec` when agentmon is on PATH.
# * Options: --ticket <key>, --db <name>, --test-db <name>, --port <n>,
#   --skip-assets, --skip-db, --force.
set -euo pipefail

ticket=
db_name=
test_db_name=
port=
skip_assets=0
skip_db=0
force=0
while [[ $# -gt 0 ]]; do
  case $1 in
  --ticket)
    ticket=$2
    shift 2
    ;;
  --ticket=*)
    ticket=${1#*=}
    shift
    ;;
  --db)
    db_name=$2
    shift 2
    ;;
  --db=*)
    db_name=${1#*=}
    shift
    ;;
  --test-db)
    test_db_name=$2
    shift 2
    ;;
  --test-db=*)
    test_db_name=${1#*=}
    shift
    ;;
  --port)
    port=$2
    shift 2
    ;;
  --port=*)
    port=${1#*=}
    shift
    ;;
  --skip-assets)
    skip_assets=1
    shift
    ;;
  --skip-db)
    skip_db=1
    shift
    ;;
  --force)
    force=1
    shift
    ;;
  *)
    echo "unknown arg: $1" >&2
    exit 1
    ;;
  esac
done

git rev-parse --is-inside-work-tree >/dev/null

worktree_path=$(git rev-parse --show-toplevel)
branch=$(git branch --show-current)
main_repo=$(git worktree list --porcelain | awk '/^worktree /{print $2; exit}')

if [[ "$worktree_path" == "$main_repo" ]]; then
  echo "Refusing to set up the main worktree ($worktree_path)" >&2
  exit 1
fi

cd "$worktree_path"

# Ticket key: a LETTERS-DIGITS token at the start of a branch path segment --
# anchoring keeps prose like "averaged-36525-day" out of the running. Branches
# carry several prefixes (lab/, chore/LMCP-, feature/lmap-...), so keep the
# project prefix in the database name; bare numbers collide across projects.
infer_ticket() {
  local -a found=()
  local key
  while read -r key; do
    key=$(tr '[:upper:]' '[:lower:]' <<<"${key#/}")
    [[ " ${found[*]:-} " == *" $key "* ]] || found+=("$key")
  done < <(grep -oE '(^|/)[A-Za-z]{2,10}-[0-9]+' <<<"$branch" || true)

  # Only trust an unambiguous match -- the wrong key silently points the app at
  # someone else's database.
  ((${#found[@]} == 1)) && printf '%s' "${found[0]}"
  return 0
}

if [[ -z "$ticket" ]]; then
  ticket=$(infer_ticket)
fi

if [[ -z "$ticket" && -z "$db_name" ]]; then
  echo "Cannot infer a ticket from branch: $branch"
  read -rp "Ticket key (e.g. LAB-408), or blank to skip: " ticket
  ticket=$(tr '[:upper:]' '[:lower:]' <<<"$ticket")
fi

if [[ -z "$db_name" ]]; then
  if [[ -n "$ticket" ]]; then
    db_name="labmaster_development_${ticket//-/_}"
  else
    echo "No ticket and no --db: nothing to point DEV_DATABASE_NAME at" >&2
    exit 1
  fi
fi

# config/database.yml reads TEST_DATABASE_NAME and appends TEST_ENV_NUMBER to
# it, so a per-worktree name keeps parallel_tests' numbered databases
# (labmaster_test_lab_4082, ...3) inside this worktree's namespace too.
#
# Mirror whatever the development name ended up as -- a hand-passed --db should
# not silently leave the test suite on the shared labmaster_test.
if [[ -z "$test_db_name" ]]; then
  if [[ "$db_name" == *_development* ]]; then
    test_db_name=${db_name/_development/_test}
  else
    test_db_name="${db_name}_test"
  fi
fi

# Port: .envrc runs `dotenv_if_exists .env.local`, so PORT set there reaches
# config/puma.rb (ENV.fetch("PORT", 3000)) and Procfile.dev alike -- both
# `bin/rails s` and `bin/dev` land on it without a flag.
#
# Seed from a hash of the database name so a worktree keeps the same port
# across re-runs (bookmarks and OAuth callbacks stay valid), then walk forward
# until a port is neither listening nor already claimed by another worktree.
port_in_use() {
  (exec 3<>"/dev/tcp/127.0.0.1/$1") 2>/dev/null
}

# Ports other worktrees have taken. A worktree whose server is stopped still
# owns its port -- an unclaimed-looking port handed out twice collides the next
# time both are running.
claimed_ports() {
  local wt env_file
  while read -r wt; do
    [[ $wt == "$worktree_path" ]] && continue
    env_file="$wt/.env.local"
    [[ -f $env_file ]] || continue
    (grep '^PORT=' "$env_file" || true) | tail -1 | cut -d= -f2- | tr -d '"'
  done < <(git worktree list --porcelain | awk '/^worktree /{print $2}')
}

# 3000 is left to the main worktree; 3001-3099 is the worktree pool.
pick_port() {
  local base candidate i claimed
  claimed=" $(claimed_ports | tr '\n' ' ') "
  base=$(cksum <<<"$db_name" | cut -d' ' -f1)
  for ((i = 0; i < 99; i++)); do
    candidate=$((3001 + (base + i) % 99))
    [[ $claimed == *" $candidate "* ]] && continue
    port_in_use "$candidate" && continue
    printf '%s' "$candidate"
    return 0
  done
  echo "No free port in 3001-3099" >&2
  return 1
}

# .env.local is gitignored, so a new worktree starts without the GitHub
# Packages token that `yarn` needs. Carry the main worktree's copy over.
env_file="$worktree_path/.env.local"
if [[ ! -f "$env_file" ]]; then
  if [[ -f "$main_repo/.env.local" ]]; then
    cp "$main_repo/.env.local" "$env_file"
    echo "Seeded .env.local from $main_repo"
  else
    echo "Warning: no .env.local in $main_repo -- yarn may fail to authenticate"
    : >"$env_file"
  fi
fi

# dotenv-rails skips .env.local when Rails.env is test -- it loads
# .env.test.local, .env.test, .env and nothing else. TEST_DATABASE_NAME in
# .env.local therefore only reaches RSpec by way of direnv exporting it into
# the shell, so a runner started outside a direnv-allowed shell quietly lands
# on the shared labmaster_test. .env.test is committed; .env.test.local is
# gitignored and loaded first, so that is where the per-worktree value goes.
test_env_file="$worktree_path/.env.test.local"
[[ -f "$test_env_file" ]] || : >"$test_env_file"

# An unterminated last line would swallow the variable we append below.
ensure_trailing_newline() {
  if [[ -s "$1" && -n $(tail -c 1 "$1") ]]; then
    printf '\n' >>"$1"
  fi
}

ensure_trailing_newline "$env_file"
ensure_trailing_newline "$test_env_file"

upsert_env() {
  local file=$1 key=$2 value=$3 existing
  if grep -q "^$key=" "$file"; then
    existing=$(grep "^$key=" "$file" | tail -1 | cut -d= -f2-)
    [[ "$existing" == "$value" ]] && return 0
    # A file holding nothing but this key leaves grep -v empty and exiting 1,
    # which set -e would take for a failure.
    grep -v "^$key=" "$file" >"$file.tmp" || true
    mv "$file.tmp" "$file"
    printf '%s=%s\n' "$key" "$value" >>"$file"
    echo "$(basename "$file") $key: $existing -> $value"
    return 0
  fi
  printf '%s=%s\n' "$key" "$value" >>"$file"
}

upsert_env "$env_file" DEV_DATABASE_NAME "$db_name"
upsert_env "$env_file" TEST_DATABASE_NAME "$test_db_name"
upsert_env "$test_env_file" TEST_DATABASE_NAME "$test_db_name"

# An already-assigned port is this worktree's own; re-running setup should not
# move a server that tabs and callbacks are already pointed at.
if [[ -z "$port" ]]; then
  port=$( (grep '^PORT=' "$env_file" || true) | tail -1 | cut -d= -f2- | tr -d '"')
fi
[[ -z "$port" ]] && port=$(pick_port)
upsert_env "$env_file" PORT "$port"

export DEV_DATABASE_NAME="$db_name"
export TEST_DATABASE_NAME="$test_db_name"
export PORT="$port"
# yarn reads npmAuthToken from the environment via .yarnrc.yml, and direnv has
# not necessarily allowed this worktree's .envrc yet.
set -a
# shellcheck disable=SC1090
source "$env_file"
set +a

if command -v direnv >/dev/null 2>&1 && [[ -f "$worktree_path/.envrc" ]]; then
  direnv allow "$worktree_path"
fi

# .rspec-local is gitignored, so a fresh worktree runs specs without the
# agent-monitor formatter until it is written. The require path it emits is
# absolute and points into the installed agentmon's share directory, so
# re-running is also how it stays current across upgrades. Not everyone has
# agentmon, and a broken formatter should not sink the whole setup.
if command -v agentmon >/dev/null 2>&1; then
  agentmon init-rspec ||
    echo "Warning: agentmon init-rspec failed -- specs will run without the agent-monitor formatter"
fi

echo ""
echo "Worktree: $worktree_path"
echo "Branch:   $branch"
echo "Database: $db_name"
echo "Test DB:  $test_db_name"
echo "Port:     $port (http://localhost:$port)"
echo ""

if ((!skip_assets)); then
  echo "== Assets =="
  yarn
  yarn build
  yarn build:css
fi

db_exists() {
  psql -tAc "SELECT 1 FROM pg_database WHERE datname = '$1'" postgres 2>/dev/null | grep -q 1
}

if ((!skip_db)); then
  echo ""
  echo "== Database =="
  reload_dev=1
  if db_exists "$db_name" && ((!force)); then
    read -rp "$db_name already exists; reload it? [y/N] " ok
    if [[ ! "$ok" =~ ^[Yy]$ ]]; then
      echo "Leaving $db_name as it is."
      reload_dev=0
    fi
  fi
  if ((reload_dev)); then
    bin/rails db:setup
  fi

  # The test database holds nothing worth keeping, so it needs no prompt -- but
  # it does need to exist: maintain_test_schema! reaches for internal metadata
  # before it considers reloading, so a missing database surfaces as
  # NoDatabaseError on the first spec rather than as a schema load.
  echo ""
  echo "Preparing $test_db_name"
  bin/rails db:test:prepare

  # parallel_tests' numbered databases are per-worktree now, so each worktree
  # needs its own copies; left to the suite they appear one slow spec run late.
  echo "For parallel specs: bundle exec rake parallel:setup"
fi
